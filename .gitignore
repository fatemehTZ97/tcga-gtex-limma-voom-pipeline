# Downloaded Xena data files (large; ~1.2GB compressed) -- not meant for git.
# Anyone running this pipeline will re-download these via the script.
data/*.gz
data/*.txt.gz
data/*.csv

# Generated figures (regenerated by running the script; keep the repo lean).
# Comment these lines out if you'd rather commit the figures for easy viewing
# on GitHub without cloning and running the pipeline.
results/*.png
results/*.svg

# R / RStudio housekeeping
.Rhistory
.RData
.Rproj.user/
*.Rproj

# renv local library cache (renv.lock itself should still be committed)
renv/library/
renv/local/
renv/python/
renv/staging/
